
import P84_4c3_GeneralKrylovDerivative

namespace Lanzarini

/-!
P84.4d1: Physical observable derivative bridge.

General four-site real Jacobi dynamics.
All six parameters remain free.

The initial state jets come from the
actual Schrodinger evolution.

The physical derivative of K is obtained
from the previously established P84.4c3
HasDerivAt theorem.

No expected Taylor or deficit coefficients.
No P79.
No sorry, admit, or new axioms.
-/

/--
The initial physical jets are generated by
the actual Jacobi Hamiltonian.
-/
theorem p84_4d1_state_initial_jet
    (p q r d e f : ℝ) (k : ℕ) :
    iteratedDeriv k
      (p84_4c1_state p q r d e f) 0 =
    (((-Complex.I) • p84_H p q r d e f) ^ k).mulVec
      p81_e0 := by
  exact p84_initial_derivatives p q r d e f k

/--
The physical derivative of Krylov complexity
is the observable J, at every real time.
-/
theorem p84_4d1_K_deriv_eq_J
    (p q r d e f t : ℝ) :
    deriv (p84_4c1_K p q r d e f) t =
      p84_4c2_J p q r d e f t := by
  exact
    (p84_4c3_K_hasDerivAt p q r d e f t).deriv

/--
The physical deficit is expressed using
the actual derivative of K, rather than
an independent formal velocity variable.
-/
theorem p84_4d1_D_physical_derivative
    (p q r d e f t : ℝ) :
    p84_4c2_D p q r d e f t =
      4 * p ^ 2 * p84_4c1_V p q r d e f t -
        (deriv (p84_4c1_K p q r d e f) t) ^ 2 := by
  rw [p84_4c2_D]
  rw [p84_4d1_K_deriv_eq_J]

#print axioms p84_4d1_state_initial_jet
#print axioms p84_4d1_K_deriv_eq_J
#print axioms p84_4d1_D_physical_derivative

end Lanzarini
