
import P85_3_GeneralPhysicalVarianceAndDeficitJets

namespace Lanzarini

/-!
P85.4 — Physical Initial Jet Evaluation.

DOI: 10.5281/zenodo.23163367
Target: four-site base case of Theorem 8.1.

Initial jets are generated from the physical matrix.
The expected coefficients occur only in theorem goals.
-/

set_option maxHeartbeats 20000000
set_option maxRecDepth 4096

/-- Initial state jets generated by matrix recursion. -/
noncomputable def p85_4_stateJet
    (p q r d e f : ℝ) :
    ℕ → Fin 4 → ℂ
  | 0 => p81_e0
  | k + 1 =>
      ((-Complex.I) •
        p84_H p q r d e f).mulVec
          (p85_4_stateJet p q r d e f k)


/-- Recursive jets agree with physical matrix powers. -/
theorem p85_4_stateJet_power
    (p q r d e f : ℝ)
    (k : ℕ) :
    p85_4_stateJet p q r d e f k =
      (((-Complex.I) •
        p84_H p q r d e f) ^ k).mulVec
          p81_e0 := by

  induction k with
  | zero =>
      simp [p85_4_stateJet]

  | succ k ih =>
      rw [p85_4_stateJet, ih]
      rw [Matrix.mulVec_mulVec]
      rw [pow_succ']


/-- Bridge to the actual physical component jets. -/
theorem p85_4_stateJet_physical
    (p q r d e f : ℝ)
    (j : Fin 4)
    (k : ℕ) :
    p85_2_z
      4
      (p84_a d e f)
      (p84_b p q r)
      p81_e0 j k 0 =
    p85_4_stateJet p q r d e f k j := by

  unfold p85_2_z

  rw [jacobiState_zero]
  rw [p85_4_stateJet_power]

  rfl


/-- Leibniz evaluation of complex products
    at the initial time. -/
noncomputable def p85_4_complexPair
    (X Y : ℕ → ℂ) :
    ℕ → ℕ → ℕ → ℂ
  | 0, i, j =>
      star (X i) * Y j
  | k + 1, i, j =>
      p85_4_complexPair X Y k (i + 1) j +
      p85_4_complexPair X Y k i (j + 1)


theorem p85_4_complexPair_bridge
    (X Y : ℕ → ℝ → ℂ)
    (k i j : ℕ) :
    p85_2_pairJet X Y k i j 0 =
      p85_4_complexPair
        (fun m => X m 0)
        (fun m => Y m 0)
        k i j := by

  induction k generalizing i j with
  | zero =>
      rfl

  | succ k ih =>
      simp only [
        p85_2_pairJet,
        p85_4_complexPair,
        ih]


/-- Initial probability derivatives. -/
noncomputable def p85_4_probabilityJet
    (p q r d e f : ℝ)
    (j : Fin 4)
    (k : ℕ) : ℝ :=
  (p85_4_complexPair
    (fun m =>
      p85_4_stateJet p q r d e f m j)
    (fun m =>
      p85_4_stateJet p q r d e f m j)
    k 0 0).re


theorem p85_4_probability_bridge
    (p q r d e f : ℝ)
    (j : Fin 4)
    (k : ℕ) :
    p85_2_probabilityJet
      4
      (p84_a d e f)
      (p84_b p q r)
      p81_e0 j k 0 =
    p85_4_probabilityJet
      p q r d e f j k := by

  unfold p85_2_probabilityJet
  unfold p85_4_probabilityJet

  rw [p85_4_complexPair_bridge]

  have hz :
      (fun m : ℕ =>
        p85_2_z
          4
          (p84_a d e f)
          (p84_b p q r)
          p81_e0 j m 0) =
      (fun m : ℕ =>
        p85_4_stateJet p q r d e f m j) := by

    funext m

    exact p85_4_stateJet_physical
      p q r d e f j m

  rw [hz]


/-- Initial Krylov moment derivatives. -/
noncomputable def p85_4_K
    (p q r d e f : ℝ)
    (k : ℕ) : ℝ :=
  ∑ j : Fin 4,
    (j.val : ℝ) *
      p85_4_probabilityJet
        p q r d e f j k


/-- Initial second moment derivatives. -/
noncomputable def p85_4_M2
    (p q r d e f : ℝ)
    (k : ℕ) : ℝ :=
  ∑ j : Fin 4,
    (j.val : ℝ) ^ 2 *
      p85_4_probabilityJet
        p q r d e f j k


theorem p85_4_K_bridge
    (p q r d e f : ℝ)
    (k : ℕ) :
    p85_3_KJet p q r d e f k 0 =
      p85_4_K p q r d e f k := by

  simp only [
    p85_3_KJet,
    p85_2_momentJet,
    p85_4_K,
    p85_4_probability_bridge]


theorem p85_4_M2_bridge
    (p q r d e f : ℝ)
    (k : ℕ) :
    p85_3_M2Jet p q r d e f k 0 =
      p85_4_M2 p q r d e f k := by

  simp only [
    p85_3_M2Jet,
    p85_2_momentJet,
    p85_4_M2,
    p85_4_probability_bridge]


/-- Real Leibniz evaluation at the initial time. -/
noncomputable def p85_4_realPair
    (X Y : ℕ → ℝ) :
    ℕ → ℕ → ℕ → ℝ
  | 0, i, j =>
      X i * Y j
  | k + 1, i, j =>
      p85_4_realPair X Y k (i + 1) j +
      p85_4_realPair X Y k i (j + 1)


theorem p85_4_realPair_bridge
    (X Y : ℕ → ℝ → ℝ)
    (k i j : ℕ) :
    p85_3_realPairJet X Y k i j 0 =
      p85_4_realPair
        (fun m => X m 0)
        (fun m => Y m 0)
        k i j := by

  induction k generalizing i j with
  | zero =>
      rfl

  | succ k ih =>
      simp only [
        p85_3_realPairJet,
        p85_4_realPair,
        ih]


/-- Initial physical variance derivatives. -/
noncomputable def p85_4_V
    (p q r d e f : ℝ)
    (k : ℕ) : ℝ :=
  p85_4_M2 p q r d e f k -
    p85_4_realPair
      (p85_4_K p q r d e f)
      (p85_4_K p q r d e f)
      k 0 0


theorem p85_4_V_bridge
    (p q r d e f : ℝ)
    (k : ℕ) :
    p85_3_VJet p q r d e f k 0 =
      p85_4_V p q r d e f k := by

  unfold p85_3_VJet p85_4_V

  rw [p85_4_M2_bridge]
  rw [p85_4_realPair_bridge]

  have hK :
      (fun m : ℕ =>
        p85_3_KJet p q r d e f m 0) =
      p85_4_K p q r d e f := by

    funext m
    exact p85_4_K_bridge
      p q r d e f m

  rw [hK]


/-- Initial physical deficit derivatives. -/
noncomputable def p85_4_F
    (p q r d e f : ℝ)
    (k : ℕ) : ℝ :=
  4 * p ^ 2 *
    p85_4_V p q r d e f k -
    p85_4_realPair
      (fun m =>
        p85_4_K p q r d e f (m + 1))
      (fun m =>
        p85_4_K p q r d e f (m + 1))
      k 0 0


theorem p85_4_F_bridge
    (p q r d e f : ℝ)
    (k : ℕ) :
    p85_3_FJet p q r d e f k 0 =
      p85_4_F p q r d e f k := by

  unfold p85_3_FJet p85_4_F

  rw [p85_4_V_bridge]
  rw [p85_4_realPair_bridge]

  have hJ :
      (fun m : ℕ =>
        p85_3_JJet p q r d e f m 0) =
      (fun m : ℕ =>
        p85_4_K p q r d e f (m + 1)) := by

    funext m

    unfold p85_3_JJet

    exact p85_4_K_bridge
      p q r d e f (m + 1)

  rw [hJ]


/-- Direct bridge from physical derivatives
    to the algebraic initial evaluator. -/
theorem p85_4_F_physical
    (p q r d e f : ℝ)
    (k : ℕ) :
    iteratedDeriv k
      (p84_4c2_D p q r d e f) 0 =
      p85_4_F p q r d e f k := by

  rw [p85_3_F_initialJet]
  exact p85_4_F_bridge
    p q r d e f k


/-- Direct physical variance bridge. -/
theorem p85_4_V_physical
    (p q r d e f : ℝ)
    (k : ℕ) :
    iteratedDeriv k
      (p84_4c1_V p q r d e f) 0 =
      p85_4_V p q r d e f k := by

  rw [p85_3_V_iteratedDeriv]
  exact p85_4_V_bridge
    p q r d e f k


/-!
Explicit matrix action for symbolic evaluation.
Derived from the existing physical Hamiltonian.
-/

theorem p85_4_generator_action
    (p q r d e f : ℝ)
    (x : Fin 4 → ℂ) :
    ((-Complex.I) •
      p84_H p q r d e f).mulVec x =
    ![
      -Complex.I * ((p : ℂ) * x 1),

      -Complex.I *
        ((p : ℂ) * x 0 +
         (d : ℂ) * x 1 +
         (q : ℂ) * x 2),

      -Complex.I *
        ((q : ℂ) * x 1 +
         (e : ℂ) * x 2 +
         (r : ℂ) * x 3),

      -Complex.I *
        ((r : ℂ) * x 2 +
         (f : ℂ) * x 3)
    ] := by

  ext i

  fin_cases i <;>
    simp [
      p84_H,
      p84_a,
      p84_b,
      jacobiComplex,
      jacobiReal,
      jacobiRealEntry,
      Matrix.mulVec,
      dotProduct,
      Fin.sum_univ_succ] <;>
    ring


/-!
Symbolic evaluation tactic.

The tactic expands only the recursive definitions
and the physical matrix action.
It contains no target polynomial.
-/

macro "p85_eval" : tactic =>
  `(tactic|
    (simp [
      p85_4_F,
      p85_4_V,
      p85_4_K,
      p85_4_M2,
      p85_4_realPair,
      p85_4_probabilityJet,
      p85_4_complexPair,
      p85_4_stateJet,
      p85_4_generator_action,
      p81_e0,
      Fin.sum_univ_succ,
      Complex.add_re,
      Complex.add_im,
      Complex.sub_re,
      Complex.sub_im,
      Complex.mul_re,
      Complex.mul_im,
      Complex.neg_re,
      Complex.neg_im] <;>
      ring))


/-!
The following coefficients are theorem goals.
They are not inputs to the evaluator.
-/

/-- Initial variance coefficient. -/
theorem p85_4_variance_second
    (p q r d e f : ℝ) :
    iteratedDeriv 2
      (p84_4c1_V p q r d e f) 0 =
      2 * p ^ 2 := by

  rw [p85_4_V_physical]
  p85_eval


/-- Fourth-order general physical deficit. -/
theorem p85_4_deficit_fourth
    (p q r d e f : ℝ) :
    iteratedDeriv 4
      (p84_4c2_D p q r d e f) 0 =
      24 * d ^ 2 * p ^ 4 := by

  rw [p85_4_F_physical]
  p85_eval


/-- Sixth-order deficit with first diagonal
    defect removed. -/
theorem p85_4_deficit_sixth
    (p q r e f : ℝ) :
    iteratedDeriv 6
      (p84_4c2_D p q r 0 e f) 0 =
      80 * p ^ 4 * q ^ 2 * e ^ 2 := by

  rw [p85_4_F_physical]
  p85_eval


/-- All initial cancellations below order eight
    in the four-site DOI base case. -/
theorem p85_4_DOI_lower_cancellations
    (p q r delta : ℝ)
    (k : Fin 8) :
    iteratedDeriv k.val
      (p84_4c2_D p q r 0 0 delta) 0 =
      0 := by

  rw [p85_4_F_physical]

  fin_cases k <;> p85_eval


/-- Eighth-order physical deficit.

The conclusion is checked against the
matrix-generated recursive expression.
-/
theorem p85_4_DOI_eighth
    (p q r delta : ℝ) :
    iteratedDeriv 8
      (p84_4c2_D p q r 0 0 delta) 0 =
    280 * p ^ 4 * q ^ 2 *
      (4 * (r ^ 2 - 3 * q ^ 2 + 3 * p ^ 2) ^ 2 +
        r ^ 2 * delta ^ 2) := by

  rw [p85_4_F_physical]
  p85_eval


